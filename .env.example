# Copy this file to ".env" and fill in your values.
# Endpoint: Foundry portal -> your resource -> "Keys and Endpoint" (or the model deployment page)
# Looks like: https://shipsense-ai.openai.azure.com   (no trailing path)
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE-NAME.openai.azure.com
AZURE_OPENAI_API_KEY=paste-key-1-here

# These are the DEPLOYMENT names you typed when deploying (not necessarily the model names)
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-small

# Azure AI Search (FREE tier). Leave endpoint empty to use the local index instead.
AZURE_SEARCH_ENDPOINT=https://YOUR-SEARCH-NAME.search.windows.net
AZURE_SEARCH_KEY=paste-admin-key-here
AZURE_SEARCH_INDEX=shipsense-knowledge

# Azure AI Document Intelligence (FREE F0). Leave empty to read PDFs with pypdf instead.
AZURE_DOCINTEL_ENDPOINT=https://YOUR-DOCINTEL-NAME.cognitiveservices.azure.com
AZURE_DOCINTEL_KEY=paste-key-1-here

# Our own API: clients must send this in the X-API-Key header
SHIPSENSE_API_KEY=change-me-long-random-string
# Shared secret used to sign/verify webhooks (HMAC-SHA256)
WEBHOOK_SECRET=change-me-another-long-random-string

# Mock carrier portal (Playwright target)
PORTAL_URL=http://127.0.0.1:8001
PORTAL_USER=demo
PORTAL_PASSWORD=demo123
